# DATABASE CONFIGURATION (PostgreSQL + PostGIS)
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=5t8ONQm7h5g91hv.mB-JRPCXdodP
DB_NAME=agrivision
DATABASE_URL=postgresql://postgres:5t8ONQm7h5g91hv.mB-JRPCXdodP@db:5432/agrivision

# SECURITY & AUTHENTICATION
SECRET_KEY=ganti_dengan_secret_key_acak_di_server
JWT_SECRET=ganti_dengan_jwt_secret_acak_di_server
SUPERADMIN_PASSWORD=ganti_password_superadmin_minimal_16_karakter

# Set ke true jika server sudah menggunakan SSL / HTTPS
AUTH_COOKIE_SECURE=false

# Masukkan domain atau IP publik VPS
CORS_ORIGINS=http://localhost,http://localhost:5173,https://domainanda.com,http://IP_PUBLIK_VPS

# Jumlah reverse proxy di depan backend (1 jika menggunakan Nginx frontend container)
TRUSTED_PROXY_COUNT=1

# OBJECT STORAGE (MINIO / S3)
USE_MINIO=true

# Contoh: http://IP_PUBLIK_VPS:9000 atau https://minio.domainanda.com
MINIO_ENDPOINT=http://IP_PUBLIK_VPS:9000
MINIO_ACCESS_KEY=ganti_access_key_khusus_minio
MINIO_SECRET_KEY=ganti_secret_key_acak_32_karakter
MINIO_BUCKET_NAME=agrivision-uploads

# APPLICATION URLS & EXTERNAL SERVICES
PUBLIC_BASE_URL=http://IP_PUBLIK_VPS

# Kredensial Google Earth Engine
GEE_SERVICE_ACCOUNT_B64=
